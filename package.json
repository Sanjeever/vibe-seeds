{
  "name": "vibe-seeds",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm --filter @vibe-seeds/api dev\" \"pnpm --filter @vibe-seeds/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @vibe-seeds/shared build && pnpm -r typecheck",
    "lint": "pnpm typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  }
}
